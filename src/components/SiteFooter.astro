---
import type { Locale } from "../data/home-content";
import {
	contactEmail,
	currentYear,
	legalLinksForLocale,
	shellContent,
	siteLinksForLocale,
	siteUrl,
} from "../data/site-shell";

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const shell = shellContent[locale];
const siteLinks = siteLinksForLocale(locale);
const legalLinks = legalLinksForLocale(locale);
---

<footer class="site-footer">
	<div class="footer-grid">
		<div class="footer-column">
			<p class="footer-label">{shell.independentLabel}</p>
			<p>{shell.independentNote}</p>
			<p>{shell.footerNotice}</p>
			<p>
				<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
			</p>
		</div>
		<div class="footer-column">
			<p class="footer-label">{shell.siteLinksHeading}</p>
			<div class="footer-links">
				{
					siteLinks.map((link) => (
						<a href={link.href}>{link.label}</a>
					))
				}
			</div>
		</div>
		<div class="footer-column">
			<p class="footer-label">{shell.legalLinksHeading}</p>
			<div class="footer-links">
				{
					legalLinks.map((link) => (
						<a href={link.href}>{link.label}</a>
					))
				}
				<a href="/sitemap-index.xml">Sitemap</a>
			</div>
		</div>
	</div>
	<p class="footer-meta">
		&copy; {currentYear} treespuzzle.com. <a href={siteUrl}>{siteUrl}</a>
	</p>
</footer>
