---
import StaticPageLayout from "../layouts/StaticPageLayout.astro";
import AdUnit from "./AdUnit.astro";
import type { Locale } from "../data/home-content";
import {
	analysisPathForLocale,
	siteUrl,
} from "../data/site-shell";
import { buildAlternateLinks } from "../data/seo";

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;

const content: Record<
	Locale,
	{
		title: string;
		description: string;
		pageHeading: string;
		pageIntro: string;
		breadcrumbLabel: string;
		headline: string;
		articleDescription: string;
		whyHeading: string;
		fitHeading: string;
		languageSwitchLabel: string;
		paragraphs: string[];
	}
> = {
	"zh-cn": {
		title: "HER TREES 为什么不一样 - 观察驱动的解谜设计",
		description: "探索 HER TREES 的独特之处：非语言解谜、黑白手绘美术、基于直觉的游戏玩法。深入解析设计哲学。",
		pageHeading: "HER TREES 为什么玩起来不一样",
