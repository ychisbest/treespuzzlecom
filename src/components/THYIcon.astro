---
type Props = {
	name:
		| "tree"
		| "star"
		| "gamepad"
		| "play"
		| "max"
		| "external"
		| "skull"
		| "brain"
		| "zap"
		| "target"
		| "map"
		| "message"
		| "quote"
		| "user"
		| "calendar"
		| "trend"
		| "sparkles"
		| "help"
		| "menu"
		| "close";
	class?: string;
};

const { name, class: className = "" } = Astro.props;
---

{
	name === "tree" && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<path d="M12 3 7 10h3l-4 5h4l-2 4h8l-2-4h4l-4-5h3Z"></path>
			<path d="M12 19v2"></path>
		</svg>
	)
}
{
	name === "star" && (
		<svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" class={className} aria-hidden="true">
			<path d="m12 2.8 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17l-5.6 3 1.1-6.2L3 9.4l6.2-.9Z"></path>
		</svg>
	)
}
{
	name === "gamepad" && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<rect x="3" y="9" width="18" height="8" rx="4"></rect>
			<path d="M8 11v4M6 13h4"></path>
			<path d="M16 12h.01M18 14h.01"></path>
		</svg>
	)
}
{
	name === "play" && (
		<svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
			<path d="M8 5.5v13l10-6.5Z"></path>
