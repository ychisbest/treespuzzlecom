---
import "../styles/global.css";
import AdUnit from "./AdUnit.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import {
	homeContent,
	type Locale,
} from "../data/home-content";
import {
	adsensePublisherId,
	globalPaths,
	shareImageUrl,
} from "../data/site-shell";
import {
	buildOgLocaleAlternates,
	guideVideoUploadDates,
	guideAlternateLinks,
	localeToHreflang,
	localeToOgLocale,
	toAbsoluteUrl,
} from "../data/seo";

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const content = homeContent[locale];
const guideEmbedUrl = "https://www.youtube.com/embed/yzNEcdAW-cU";
const puzzleDreamGuidePath =
	locale === "en"
		? "/play/puzzle-dream/guide/"
		: `/${locale}/play/puzzle-dream/guide/`;
const puzzleHouseGuidePath =
	locale === "en"
		? "/play/puzzle-house/guide/"
		: `/${locale}/play/puzzle-house/guide/`;

const languageLinks = guideAlternateLinks(locale);

const guideSupport: Record<
	Locale,
	{
		breadcrumbLabel: string;
		beforeHeading: string;
		beforeBody: string;
		videoHeading: string;
		videoBody: string;
		afterHeading: string;
		afterBody: string;
		nextHeading: string;
		nextBody: string;
		analysisLabel: string;
		scopeNote: string;
		dreamGuideLabel: string;
		houseGuideLabel: string;
		dreamGuideBody: string;
		houseGuideBody: string;
	}
> = {
	"zh-cn": {
		breadcrumbLabel: "攻略",
		beforeHeading: "看视频前先做什么",
		beforeBody:
			"建议先自己观察可移动物件、重复图形和右侧密码区域，再决定是否需要完整视频。这样既能保留顿悟感，也更容易理解视频里每一步为什么成立。",
		videoHeading: "这个视频适合什么情况",
		videoBody:
			"如果你已经卡住，或者只想确认某一步是否理解正确，嵌入视频可以直接帮助你对照场景顺序。它更适合当作完整解法，而不是第一时间就打开的教程。",
		afterHeading: "更稳妥的使用方式",
		afterBody:
			"先自己尝试一次，再回到这里看完整视频，体验会更平衡，也更容易理解每个动作之间的关联。",
		nextHeading: "继续阅读",
		nextBody: "如果你还想看系列定位和玩法判断，可以继续查看分析页面。",
		analysisLabel: "玩法解析",
		scopeNote: "本页只覆盖 First Puzzle。Dream 和 House 请打开各自的攻略页。",
		dreamGuideLabel: "Her Trees Puzzle Dream 攻略",
		houseGuideLabel: "Her Trees The Puzzle House 攻略",
		dreamGuideBody: "打开 Puzzle Dream 键盘答案表和视频。",
		houseGuideBody: "打开 Puzzle House 键盘答案表和视频。",
	},
	en: {
		breadcrumbLabel: "Guide",
		beforeHeading: "Before you watch",
		beforeBody:
			"Give yourself a few minutes with the room before opening the full guide. HER TREES is at its best when you first test object relationships, repeated symbols, and the code area on your own.",
		videoHeading: "What this video is best for",
		videoBody:
			"The embedded guide works best when you already know the mood and want a direct answer. It is a full spoiler resource, so it is more useful as a recovery tool than as your first step.",
		afterHeading: "A better hint flow",
		afterBody:
			"Try the puzzle yourself first, then return here if the logic still does not click. That keeps more of the discovery intact while still giving you a reliable fallback.",
		nextHeading: "More original reading",
		nextBody:
			"If you want series analysis in addition to the video, continue with the page below.",
		analysisLabel: "Puzzle Design Analysis",
		scopeNote:
			"This page covers First Puzzle only. Open the dedicated guides for Puzzle Dream and Puzzle House.",
		dreamGuideLabel: "Her Trees Puzzle Dream walkthrough",
		houseGuideLabel: "Her Trees The Puzzle House walkthrough",
		dreamGuideBody: "Open every Her Trees Puzzle Dream keypad code, then the video.",
		houseGuideBody: "Open every Puzzle House keypad code, then the video.",
	},
	fa: {
		breadcrumbLabel: "راهنما",
		beforeHeading: "قبل از تماشای ویدیو",
		beforeBody:
			"چند دقیقه خودتان اتاق را امتحان کنید. HER TREES وقتی بهترین است که ابتدا روابط اشیاء، نمادهای تکراری و ناحیه کد را خودتان تست کنید.",
		videoHeading: "این ویدیو برای چه مواقعی مناسب است",
		videoBody:
			"راهنمای جاسازی‌شده وقتی بهترین است که قبلاً حس و حال را می‌شناسید و مستقیماً پاسخ می‌خواهید. منبع اسپویلر کامل است، بنابراین به‌عنوان ابزار بازیابی مفیدتر است تا اولین قدم.",
		afterHeading: "جریان بهتر راهنما",
		afterBody:
			"ابتدا خودتان پازل را امتحان کنید، سپس اگر منطق هنوز کلیک نکرد اینجا برگردید. این بیشتر کشف را حفظ می‌کند و در عین حال پشتیبان قابل اعتمادی به شما می‌دهد.",
		nextHeading: "مطالعه بیشتر",
		nextBody: "اگر علاوه بر ویدیو تحلیل مجموعه را می‌خواهید، به صفحه زیر ادامه دهید.",
		analysisLabel: "تحلیل طراحی پازل",
		scopeNote:
			"این صفحه فقط First Puzzle را پوشش می‌دهد. برای Dream و House صفحات راهنمای جدا را باز کنید.",
		dreamGuideLabel: "Her Trees Puzzle Dream راهنما",
		houseGuideLabel: "راهنمای Puzzle House",
		dreamGuideBody: "ویدیوی راهنمای مستقل Puzzle Dream را باز کنید.",
		houseGuideBody: "ویدیوی راهنمای مستقل Puzzle House را باز کنید.",
	},
	fr: {
		breadcrumbLabel: "Guide",
		beforeHeading: "Avant de regarder",
		beforeBody:
			"Accordez-vous quelques minutes avec la pièce avant d'ouvrir le guide complet. HER TREES est à son meilleur quand vous testez d'abord les relations entre objets, les symboles répétés et la zone de code par vous-même.",
		videoHeading: "À quoi sert cette vidéo",
		videoBody:
			"Le guide intégré fonctionne mieux quand vous connaissez déjà l'ambiance et voulez une réponse directe. C'est une ressource spoiler complète, donc plus utile comme outil de récupération que comme première étape.",
		afterHeading: "Un meilleur flux d'indices",
		afterBody:
			"Essayez le puzzle vous-même d'abord, puis revenez ici si la logique ne clique toujours pas. Cela préserve davantage la découverte tout en vous donnant une solution de secours fiable.",
		nextHeading: "Lire la suite",
		nextBody: "Si vous souhaitez une analyse de la série en plus de la vidéo, continuez avec la page ci-dessous.",
		analysisLabel: "Analyse de la Conception des Puzzles",
		scopeNote:
			"Cette page couvre uniquement First Puzzle. Ouvrez les guides dédiés pour Puzzle Dream et Puzzle House.",
		dreamGuideLabel: "Her Trees Puzzle Dream walkthrough",
		houseGuideLabel: "Guide Puzzle House",
		dreamGuideBody: "Ouvrir la vidéo de guide dédiée à Puzzle Dream.",
		houseGuideBody: "Ouvrir la vidéo de guide dédiée à Puzzle House.",
	},
	id: {
		breadcrumbLabel: "Panduan",
		beforeHeading: "Sebelum menonton video",
		beforeBody:
			"Luangkan beberapa menit untuk mengamati ruangan sendiri terlebih dahulu. HER TREES paling seru ketika kamu pertama kali menguji hubungan antar objek, simbol berulang, dan area kode secara mandiri.",
		videoHeading: "Video ini cocok untuk situasi apa",
		videoBody:
			"Panduan yang tertanam paling berguna ketika kamu sudah mengenal suasananya dan ingin jawaban langsung. Ini sumber spoiler lengkap, jadi lebih cocok dipakai sebagai pemulihan daripada langkah pertama.",
		afterHeading: "Alur petunjuk yang lebih baik",
		afterBody:
			"Coba selesaikan puzzle sendiri dulu, lalu kembali ke sini jika logikanya belum juga terasa. Cara ini mempertahankan lebih banyak rasa penemuan sambil tetap memberikan cadangan yang bisa diandalkan.",
		nextHeading: "Bacaan lanjutan",
		nextBody: "Jika kamu ingin analisis seri selain video, lanjutkan ke halaman di bawah ini.",
		analysisLabel: "Analisis Desain Puzzle",
		scopeNote:
			"Halaman ini hanya untuk First Puzzle. Buka panduan terpisah untuk Puzzle Dream dan Puzzle House.",
		dreamGuideLabel: "Her Trees Puzzle Dream walkthrough",
		houseGuideLabel: "Panduan Puzzle House",
		dreamGuideBody: "Buka video panduan khusus Puzzle Dream.",
		houseGuideBody: "Buka video panduan khusus Puzzle House.",
	},
	ja: {
		breadcrumbLabel: "攻略",
		beforeHeading: "動画を見る前に",
		beforeBody:
			"まずは自分で少し観察してみるのがおすすめです。動かせる物、繰り返し出る記号、コード入力部分を見てから動画に入ると、ひらめきが残りやすくなります。",
		videoHeading: "この動画が向いている場面",
		videoBody:
			"埋め込み動画は完全な答えを確認したいときに向いています。最初から見るより、行き詰まったあとに使うほうがシリーズの良さを残せます。",
		afterHeading: "おすすめの見方",
		afterBody:
			"先に自力で試し、それでも止まったらこの動画に戻る流れが最も自然です。",
		nextHeading: "関連ページ",
		nextBody: "分析記事も用意しているので、必要に応じて続けて確認できます。",
		analysisLabel: "分析記事",
		scopeNote:
			"このページは First Puzzle だけです。Dream と House はそれぞれの攻略ページを開いてください。",
		dreamGuideLabel: "Her Trees Puzzle Dream 攻略",
		houseGuideLabel: "Her Trees The Puzzle House 攻略",
		dreamGuideBody: "Puzzle Dream 専用の攻略動画を開く。",
		houseGuideBody: "Puzzle House 専用の攻略動画を開く。",
	},
	vi: {
		breadcrumbLabel: "Huong dan",
		beforeHeading: "Truoc khi mo video",
		beforeBody:
			"Hay tu quan sat phong choi trong vai phut truoc. HER TREES hay hon khi ban tu thu ket noi do vat, ky hieu lap lai, va khu vuc ma so truoc khi xem loi giai day du.",
		videoHeading: "Video nay phu hop luc nao",
		videoBody:
			"Video nhung vao day phu hop nhat khi ban da bi mac va can mot loi giai truc tiep. Day la tai nguyen co spoiler day du, vi vay nen dung sau khi da thu tu minh.",
		afterHeading: "Cach dung hop ly hon",
		afterBody:
			"Hay thu tu minh truoc, roi moi quay lai day neu ban van con mac. Cach nay giu duoc nhieu cam giac tu kham pha hon.",
		nextHeading: "Doc tiep",
		nextBody: "Neu ban muon doc them ve thiet ke cua dong game, hay mo bai phan tich.",
		analysisLabel: "Phan tich thiet ke",
		scopeNote:
			"Trang nay chi la First Puzzle. Mo trang huong dan rieng cho Puzzle Dream va Puzzle House.",
		dreamGuideLabel: "Her Trees Puzzle Dream walkthrough",
		houseGuideLabel: "Huong dan Puzzle House",
		dreamGuideBody: "Mo video huong dan rieng cua Puzzle Dream.",
		houseGuideBody: "Mo video huong dan rieng cua Puzzle House.",
	},
};

const guideNotes = guideSupport[locale];
const canonicalUrl = toAbsoluteUrl(content.guidePath);
const homeUrl = toAbsoluteUrl(content.path);
const ogLocale = localeToOgLocale(locale);
const ogLocaleAlternates = buildOgLocaleAlternates(locale);
const guideSchema = JSON.stringify([
	{
		"@context": "https://schema.org",
		"@type": "VideoObject",
		name: content.guidePageTitle,
		description: content.guidePageDescription,
		embedUrl: guideEmbedUrl,
		url: canonicalUrl,
		thumbnailUrl: shareImageUrl,
		uploadDate: guideVideoUploadDates.firstPuzzle,
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: homeUrl,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: guideNotes.breadcrumbLabel,
				item: canonicalUrl,
			},
		],
	},
]);
---

<html lang={content.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#111111" />
		<meta name="generator" content={Astro.generator} />
		<title>{content.guidePageTitle}</title>
		<meta name="description" content={content.guidePageDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="index, follow" />
		<meta property="og:title" content={content.guidePageTitle} />
		<meta property="og:description" content={content.guidePageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={content.siteName} />
		<meta property="og:locale" content={ogLocale} />
		{
			ogLocaleAlternates.map((alternateLocale) => (
				<meta property="og:locale:alternate" content={alternateLocale} />
			))
		}
		<meta property="og:image" content={shareImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={content.guidePageTitle} />
		<meta name="twitter:description" content={content.guidePageDescription} />
		<meta name="twitter:image" content={shareImageUrl} />
		<meta name="google-adsense-account" content={adsensePublisherId} />
		{
			languageLinks.map((link) => (
				<link
					rel="alternate"
					hreflang={localeToHreflang(link.locale)}
					href={toAbsoluteUrl(link.href)}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={toAbsoluteUrl("/guide/")} />
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsensePublisherId}`}
			crossorigin="anonymous"
		></script>
		<script type="application/ld+json" set:html={guideSchema}></script>
	</head>
	<body>
		<div class="container-shell">
			<SiteHeader
				locale={locale}
				currentPath={content.guidePath}
				tagline={content.guidePageDescription}
				languageSwitchLabel={content.languageSwitchLabel}
				languageLinks={languageLinks}
			/>

			<main>
				<nav class="breadcrumb-trail" aria-label="Breadcrumb">
					<a href={content.path}>{content.backHomeLabel}</a>
					<span>/</span>
					<span aria-current="page">{guideNotes.breadcrumbLabel}</span>
				</nav>

				<section class="page-intro-block">
					<h1>{content.guidePageTitle}</h1>
					<p>{content.guidePageDescription}</p>
					<p class="guide-scope-note">{guideNotes.scopeNote}</p>
					<div class="more-play-grid">
						<a class="more-play-card" href={puzzleDreamGuidePath}>
							<strong>{guideNotes.dreamGuideLabel}</strong>
							<span>Her Trees Puzzle Dream keypad answers</span>
						</a>
						<a class="more-play-card" href={puzzleHouseGuidePath}>
							<strong>{guideNotes.houseGuideLabel}</strong>
							<span>Her Trees The Puzzle House keypad answers</span>
						</a>
					</div>
				</section>

				<section class="guide-frame-shell">
					<iframe
						class="guide-frame"
						src={guideEmbedUrl}
						title={content.guideIframeTitle}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					></iframe>
				</section>

				<AdUnit />

				<section class="content-section">
					<h2>{guideNotes.beforeHeading}</h2>
					<div class="prose-block">
						<p>{guideNotes.beforeBody}</p>
					</div>
				</section>

				<section class="content-section">
					<h2>{guideNotes.videoHeading}</h2>
					<div class="prose-block">
						<p>{guideNotes.videoBody}</p>
					</div>
				</section>

				<section class="content-section">
					<h2>{guideNotes.afterHeading}</h2>
					<div class="prose-block">
						<p>{guideNotes.afterBody}</p>
					</div>
				</section>

				<section class="content-section">
					<h2>{guideNotes.nextHeading}</h2>
					<p class="section-intro">{guideNotes.nextBody}</p>
					<div class="resource-grid">
						<article class="resource-card">
							<h3>
								<a href={puzzleDreamGuidePath}>{guideNotes.dreamGuideLabel}</a>
							</h3>
							<p>{guideNotes.dreamGuideBody}</p>
						</article>
						<article class="resource-card">
							<h3>
								<a href={puzzleHouseGuidePath}>{guideNotes.houseGuideLabel}</a>
							</h3>
							<p>{guideNotes.houseGuideBody}</p>
						</article>
						<article class="resource-card">
							<h3>
								<a href={globalPaths.analysis}>{guideNotes.analysisLabel}</a>
							</h3>
							<p>{guideNotes.videoBody}</p>
						</article>
					</div>
				</section>
			</main>

			<SiteFooter locale={locale} />
		</div>
	</body>
</html>
