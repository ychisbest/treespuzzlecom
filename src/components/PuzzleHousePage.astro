---
import { Image } from "astro:assets";
import puzzleHouseImage from "../assets/puzzle_house.jpg";
import firstPuzzleImage from "../assets/first_puzzle.png";
import puzzleDreamImage from "../assets/puzzle_dream.png";
import "../styles/global.css";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import {
	homeContent,
	type Locale,
} from "../data/home-content";
import {
	adsensePublisherId,
	siteUrl,
} from "../data/site-shell";
import {
	buildAlternateLinks,
	buildOgLocaleAlternates,
	localeToHreflang,
	localeToOgLocale,
	toAbsoluteUrl,
} from "../data/seo";

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const content = homeContent[locale];
const puzzleHouseEmbedUrl =
	"https://game.doritosscript.com/her-trees-puzzle-house/index.html";
const puzzleHousePath =
	locale === "en" ? "/play/puzzle-house/" : `/${locale}/play/puzzle-house/`;
const puzzleHouseGuidePath =
	locale === "en"
		? "/play/puzzle-house/guide/"
		: `/${locale}/play/puzzle-house/guide/`;
const firstPuzzlePagePath = `${content.path}#play`;
const puzzleDreamPath =
	locale === "en" ? "/play/puzzle-dream/" : `/${locale}/play/puzzle-dream/`;
const puzzleHouseDownloadUrl =
	"https://game.doritosscript.com/HER.TREES.THE.PUZZLE.HOUSE.zip";
const shareImage = new URL(puzzleHouseImage.src, siteUrl).toString();

const languageLinks = buildAlternateLinks(
	{
		en: "/play/puzzle-house/",
		"zh-cn": "/zh-cn/play/puzzle-house/",
		ja: "/ja/play/puzzle-house/",
		vi: "/vi/play/puzzle-house/",
	},
	locale,
);

const relatedGames = content.games
	.map((game, index) => ({
		...game,
		image: [firstPuzzleImage, puzzleHouseImage, puzzleDreamImage][index],
		href:
			index === 0
				? firstPuzzlePagePath
				: index === 1
					? puzzleHousePath
					: puzzleDreamPath,
	}))
	.filter((_, index) => index !== 1);

const pageCopy: Record<
	Locale,
	{
		title: string;
		description: string;
		breadcrumbLabel: string;
		playHeading: string;
		iframeTitle: string;
		playButton: string;
		intro: string;
		overviewHeading: string;
		overviewBody: string;
		tipsHeading: string;
		tips: string[];
	}
> = {
	"zh-cn": {
		title: "HER TREES : THE PUZZLE HOUSE 在线试玩",
		description:
			"进入 HER TREES : THE PUZZLE HOUSE 页面，直接在站内打开浏览器版游戏并体验完整短篇谜题屋。",
		breadcrumbLabel: "Puzzle House",
		playHeading: "游玩 HER TREES : THE PUZZLE HOUSE",
		iframeTitle: "HER TREES : THE PUZZLE HOUSE 在线试玩",
		playButton: "开始 Puzzle House",
		intro:
			"这个页面直接加载 public 目录中的 Puzzle House 游戏资源，进入后可以像首页一样点击开始并切换全屏游玩。",
		overviewHeading: "这一页提供什么",
		overviewBody:
			"这是系列第二作的独立入口，适合想先体验更完整成品，但又不想一上来就进入第三作更长流程的玩家。",
		tipsHeading: "游玩提示",
		tips: [
			"首次进入会按需加载 WebGL 资源，开始前可能需要短暂等待。",
			"手机上建议横屏体验；进入全屏时页面会尽量请求横屏锁定。",
			"如果你想先从最短体验开始，仍然可以回首页游玩 First Puzzle。",
		],
	},
	en: {
		title: "HER TREES : THE PUZZLE HOUSE Online",
		description:
			"Open HER TREES : THE PUZZLE HOUSE in its own page and play the browser build directly from this site.",
		breadcrumbLabel: "Puzzle House",
		playHeading: "Play HER TREES : THE PUZZLE HOUSE",
		iframeTitle: "HER TREES : THE PUZZLE HOUSE online",
		playButton: "Start Puzzle House",
		intro:
			"This page loads the Puzzle House build from the public directory and keeps the same click-to-launch and fullscreen flow used on the homepage.",
		overviewHeading: "What this page is for",
		overviewBody:
			"This is a dedicated entry for the second game in the series, useful when you want a fuller standalone room before moving on to Puzzle Dream.",
		tipsHeading: "Play notes",
		tips: [
			"The first launch may take a moment while the WebGL files load.",
			"Landscape works best on phones; fullscreen will try to lock orientation.",
			"If you want the shortest starting point first, go back to the homepage and start with First Puzzle.",
		],
	},
	ja: {
		title: "HER TREES : THE PUZZLE HOUSE をブラウザで遊ぶ",
		description:
			"HER TREES : THE PUZZLE HOUSE の専用ページです。サイト内でそのままブラウザ版を起動できます。",
		breadcrumbLabel: "Puzzle House",
		playHeading: "HER TREES : THE PUZZLE HOUSE を遊ぶ",
		iframeTitle: "HER TREES : THE PUZZLE HOUSE ブラウザ版",
		playButton: "Puzzle House を始める",
		intro:
			"このページでは public ディレクトリ内の Puzzle House ビルドを読み込み、トップページと同じようにクリックして起動し、全画面でも遊べます。",
		overviewHeading: "このページの役割",
		overviewBody:
			"シリーズ第2作へ直接入るための専用ページです。Puzzle Dream より前に、よりまとまった短編作品を遊びたい人に向いています。",
		tipsHeading: "プレイのヒント",
		tips: [
			"初回起動では WebGL ファイルの読み込みに少し時間がかかる場合があります。",
			"スマートフォンでは横画面が向いています。全画面時は横向き固定を試みます。",
			"まず最短の導入から入りたい場合は、トップページの First Puzzle が適しています。",
		],
	},
	vi: {
		title: "Choi HER TREES : THE PUZZLE HOUSE tren trinh duyet",
		description:
			"Mo trang rieng cho HER TREES : THE PUZZLE HOUSE va choi ban browser truc tiep tren website.",
		breadcrumbLabel: "Puzzle House",
		playHeading: "Choi HER TREES : THE PUZZLE HOUSE",
		iframeTitle: "HER TREES : THE PUZZLE HOUSE tren trinh duyet",
		playButton: "Bat dau Puzzle House",
		intro:
			"Trang nay tai ban Puzzle House nam trong thu muc public, giu cung cach bam de mo game va choi fullscreen giong trang chu.",
		overviewHeading: "Trang nay dung de lam gi",
		overviewBody:
			"Day la loi vao rieng cho phan thu hai trong series, phu hop neu ban muon choi mot tac pham ngan hon truoc khi chuyen sang Puzzle Dream.",
		tipsHeading: "Luu y khi choi",
		tips: [
			"Lan mo dau tien co the can doi trong luc tai tep WebGL.",
			"Dien thoai nen choi ngang man hinh; fullscreen se co gang khoa huong ngang.",
			"Neu ban muon bat dau bang trai nghiem ngan nhat, hay quay ve trang chu va choi First Puzzle.",
		],
	},
};

const copy = pageCopy[locale];
const guideNoteCopy: Record<
	Locale,
	{
		prefix: string;
		linkLabel: string;
	}
> = {
	"zh-cn": {
		prefix: "如果遇到卡关，",
		linkLabel: "点击此处查看视频攻略",
	},
	en: {
		prefix: "If you get stuck, ",
		linkLabel: "watch the video guide here",
	},
	ja: {
		prefix: "行き詰まったら、",
		linkLabel: "こちらから攻略動画を確認してください",
	},
	vi: {
		prefix: "Neu bi mac o mot doan, ",
		linkLabel: "bam vao day de xem video huong dan",
	},
};
const downloadCopy: Record<
	Locale,
	{
		label: string;
		note: string;
	}
> = {
	"zh-cn": {
		label: "完整版游戏下载",
		note: "Windows 平台可直接游玩",
	},
	en: {
		label: "Download Full Game",
		note: "Windows version, playable directly after download",
	},
	ja: {
		label: "完整版ゲームをダウンロード",
		note: "Windows 版を直接プレイできます",
	},
	vi: {
		label: "Tai ban day du",
		note: "Ban Windows co the choi truc tiep",
	},
};
const canonicalUrl = toAbsoluteUrl(puzzleHousePath);
const ogLocale = localeToOgLocale(locale);
const ogLocaleAlternates = buildOgLocaleAlternates(locale);
const puzzleHouseSchema = JSON.stringify([
	{
		"@context": "https://schema.org",
		"@type": "VideoGame",
		name: "HER TREES : THE PUZZLE HOUSE",
		url: canonicalUrl,
		description: copy.description,
		image: shareImage,
		gamePlatform: "Web Browser",
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: toAbsoluteUrl(content.path),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: copy.breadcrumbLabel,
				item: canonicalUrl,
			},
		],
	},
]);
---

<html lang={content.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#111111" />
		<meta name="generator" content={Astro.generator} />
		<title>{copy.title}</title>
		<meta name="description" content={copy.description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="index, follow" />
		<meta property="og:title" content={copy.title} />
		<meta property="og:description" content={copy.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={content.siteName} />
		<meta property="og:locale" content={ogLocale} />
		{
			ogLocaleAlternates.map((alternateLocale) => (
				<meta property="og:locale:alternate" content={alternateLocale} />
			))
		}
		<meta property="og:image" content={shareImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={copy.title} />
		<meta name="twitter:description" content={copy.description} />
		<meta name="twitter:image" content={shareImage} />
		<meta name="google-adsense-account" content={adsensePublisherId} />
		{
			languageLinks.map((link) => (
				<link
					rel="alternate"
					hreflang={localeToHreflang(link.locale)}
					href={toAbsoluteUrl(link.href)}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={toAbsoluteUrl("/play/puzzle-house/")} />
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsensePublisherId}`}
			crossorigin="anonymous"
		></script>
		<script type="application/ld+json" set:html={puzzleHouseSchema}></script>
	</head>
	<body>
		<div class="container-shell">
			<SiteHeader
				locale={locale}
				currentPath={puzzleHousePath}
				tagline={copy.description}
				languageSwitchLabel={content.languageSwitchLabel}
				languageLinks={languageLinks}
			/>

			<main>
				<nav class="breadcrumb-trail" aria-label="Breadcrumb">
					<a href={content.path}>{content.backHomeLabel}</a>
					<span>/</span>
					<span aria-current="page">{copy.breadcrumbLabel}</span>
				</nav>

				<section class="hero-section">
					<div class="feature-panel">
						<div class="panel-header">
							<h2>{copy.playHeading}</h2>
						</div>
						<div class="feature-box game-embed-shell">
							<button
								type="button"
								class="embed-launch"
								data-game-launch
								data-zoom-surface
								data-embed-src={puzzleHouseEmbedUrl}
								data-target-id="puzzle-house-game"
								aria-controls="puzzle-house-game"
								style={`--launch-image: url(${puzzleHouseImage.src})`}
							>
								<span class="embed-launch-image" aria-hidden="true"></span>
								<span class="embed-launch-overlay" aria-hidden="true"></span>
								<span class="embed-launch-content">
									<span class="embed-kicker">HER TREES : The Puzzle House</span>
									<strong>{copy.playButton}</strong>
								</span>
							</button>
							<iframe
								id="puzzle-house-game"
								class="game-embed"
								title={copy.iframeTitle}
								loading="lazy"
								allow="fullscreen; autoplay"
								referrerpolicy="strict-origin-when-cross-origin"
							></iframe>
							<div class="rotate-hint" data-rotate-hint aria-live="polite">
								<p>{content.rotateHint}</p>
							</div>
						</div>
						<div class="game-toolbar">
							<div class="game-actions">
								<button
									type="button"
									class="fullscreen-button"
									data-game-fullscreen
									data-target-id="puzzle-house-game"
									aria-controls="puzzle-house-game"
								>
									<span class="fullscreen-button-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path
												d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
												fill="none"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path>
										</svg>
									</span>
									<span>{content.fullscreenButton}</span>
								</button>
							</div>
							<p class="game-intro">{copy.overviewBody}</p>
						</div>
						<div class="guide-card">
							<p class="guide-note">
								{guideNoteCopy[locale].prefix}
								<a href={puzzleHouseGuidePath} class="guide-inline-link">
									{guideNoteCopy[locale].linkLabel}
								</a>
							</p>
						</div>
						<div class="download-card">
							<p class="download-note">
								<a
									href={puzzleHouseDownloadUrl}
									class="download-link download-button"
									target="_blank"
									rel="noreferrer"
								>
									<span class="download-button-icons" aria-hidden="true">
										<svg viewBox="0 0 24 24" class="download-icon">
											<path
												d="M3 5.75 11.1 4.6v7.06H3V5.75Zm9.2-1.31L21 3.2v8.46h-8.8V4.44ZM3 12.82h8.1v7.07L3 18.73v-5.91Zm9.2 0H21v8.47l-8.8-1.24v-7.23Z"
												fill="currentColor"
											></path>
										</svg>
										<svg viewBox="0 0 24 24" class="download-icon">
											<path
												d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.29a1 1 0 1 1 1.4 1.41l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.41L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1Z"
												fill="currentColor"
											></path>
										</svg>
									</span>
									<span>{downloadCopy[locale].label}</span>
								</a>
								<span>{downloadCopy[locale].note}</span>
							</p>
						</div>
						</div>
					</section>

				<section class="content-section" id="series">
					<h2>{content.seriesHeading}</h2>
					<div class="games-grid">
						{
							relatedGames.map((game) => (
								<a class="game-card game-card-link" href={game.href}>
									<div class="game-thumbnail">
										<Image
											src={game.image}
											alt={game.alt}
											widths={[480]}
											sizes="(max-width: 760px) 100vw, 280px"
										/>
									</div>
									<p class="game-meta">{game.meta}</p>
									<h3 class="game-title">{game.title}</h3>
									<p class="game-desc">{game.copy}</p>
								</a>
							))
						}
					</div>
				</section>

				<section class="content-section">
					<h2>{copy.overviewHeading}</h2>
					<div class="prose-block">
						<p>{copy.overviewBody}</p>
					</div>
				</section>

				<section class="content-section">
					<h2>{copy.tipsHeading}</h2>
					<div class="bullet-grid">
						{
							copy.tips.map((item) => (
								<article class="bullet-card">
									<p>{item}</p>
								</article>
							))
						}
					</div>
				</section>
			</main>

			<SiteFooter locale={locale} />
		</div>
		<script is:inline>
			const fullscreenTargets = new Set();

			const loadEmbeddedGame = (trigger) => {
				const targetId = trigger.getAttribute("data-target-id");
				const src = trigger.getAttribute("data-embed-src");
				if (!targetId || !src) return null;

				const iframe = document.getElementById(targetId);
				if (!(iframe instanceof HTMLIFrameElement)) return null;

				if (iframe.dataset.loaded !== "true") {
					iframe.src = src;
					iframe.dataset.loaded = "true";
				}

				iframe.classList.add("is-visible");
				trigger.classList.add("is-hidden");
				return iframe;
			};

			const isMobileViewport = () =>
				window.matchMedia("(pointer: coarse)").matches &&
				Math.min(window.innerWidth, window.innerHeight) < 1024;

			const updateRotateHintState = (target, shouldShowHint) => {
				if (!(target instanceof HTMLElement)) return;

				if (shouldShowHint) {
					target.dataset.rotateHintVisible = "true";
					return;
				}

				delete target.dataset.rotateHintVisible;
			};

			const tryLockLandscape = async (target) => {
				if (!(target instanceof HTMLElement)) return false;

				if (!screen.orientation?.lock || !isMobileViewport()) {
					updateRotateHintState(target, false);
					return false;
				}

				try {
					await screen.orientation.lock("landscape");
					updateRotateHintState(target, false);
					return true;
				} catch {
					updateRotateHintState(target, true);
					return false;
				}
			};

			const releaseOrientationLock = () => {
				try {
					screen.orientation?.unlock?.();
				} catch {
					/* no-op */
				}
			};

			document.addEventListener("fullscreenchange", () => {
				fullscreenTargets.forEach((target) => {
					if (!(target instanceof HTMLElement)) return;

					const isActive = document.fullscreenElement === target;
					if (!isActive) {
						updateRotateHintState(target, false);
					}
				});

				if (!document.fullscreenElement) {
					releaseOrientationLock();
				}
			});

			document.querySelectorAll("[data-game-launch]").forEach((button) => {
				button.addEventListener("click", () => {
					loadEmbeddedGame(button);
				});
			});

			document.querySelectorAll("[data-game-fullscreen]").forEach((button) => {
				button.addEventListener("click", async () => {
					const targetId = button.getAttribute("data-target-id");
					if (!targetId) return;

					const iframe = document.getElementById(targetId);
					if (!(iframe instanceof HTMLIFrameElement)) return;

					const launchButton = document.querySelector(
						`[data-game-launch][data-target-id="${targetId}"]`,
					);
					if (launchButton instanceof HTMLButtonElement) {
						loadEmbeddedGame(launchButton);
					}

					const fullscreenTarget = iframe.closest(".game-embed-shell");
					if (!(fullscreenTarget instanceof HTMLElement)) return;
					fullscreenTargets.add(fullscreenTarget);

					if (document.fullscreenElement === fullscreenTarget) {
						await document.exitFullscreen?.();
						return;
					}

					if (fullscreenTarget.requestFullscreen) {
						await fullscreenTarget.requestFullscreen();
						await tryLockLandscape(fullscreenTarget);
					}
				});
			});

			document.querySelectorAll("[data-zoom-surface]").forEach((surface) => {
				if (!(surface instanceof HTMLElement)) return;

				const resetSurface = () => {
					surface.style.setProperty("--pointer-x", "50%");
					surface.style.setProperty("--pointer-y", "50%");
				};

				resetSurface();

				surface.addEventListener("mousemove", (event) => {
					const rect = surface.getBoundingClientRect();
					const x = ((event.clientX - rect.left) / rect.width) * 100;
					const y = ((event.clientY - rect.top) / rect.height) * 100;

					surface.style.setProperty("--pointer-x", `${x}%`);
					surface.style.setProperty("--pointer-y", `${y}%`);
				});

				surface.addEventListener("mouseleave", resetSurface);
			});
		</script>
	</body>
</html>
