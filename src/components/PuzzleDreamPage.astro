---
import { Image } from "astro:assets";
import firstPuzzleImage from "../assets/first_puzzle.png";
import puzzleHouseImage from "../assets/puzzle_house.jpg";
import puzzleDreamImage from "../assets/puzzle_dream.png";
import treesHateYouImage from "../assets/trees-hate-you.png";
import "../styles/global.css";
import AdUnit from "./AdUnit.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import {
	homeContent,
	type Locale,
} from "../data/home-content";
import {
	adsensePublisherId,
	siteUrl,
} from "../data/site-shell";
import {
	buildAlternateLinks,
	buildOgLocaleAlternates,
	localeToHreflang,
	localeToOgLocale,
	toAbsoluteUrl,
} from "../data/seo";

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const content = homeContent[locale];
const puzzleDreamEmbedUrl =
	"https://game.doritosscript.com/puzzle-dream/index.html";
const puzzleDreamPath =
	locale === "en" ? "/play/puzzle-dream/" : `/${locale}/play/puzzle-dream/`;
const puzzleDreamGuidePath =
	locale === "en"
		? "/play/puzzle-dream/guide/"
		: `/${locale}/play/puzzle-dream/guide/`;
const firstPuzzlePagePath = `${content.path}#play`;
const puzzleHousePath =
	locale === "en" ? "/play/puzzle-house/" : `/${locale}/play/puzzle-house/`;
const treesHateYouPath = "/trees-hate-you/";
const puzzleDreamDownloadUrl =
	"https://game.doritosscript.com/HerTreesPuzzleDream.zip";
const shareImage = new URL(puzzleDreamImage.src, siteUrl).toString();
const gameImages = [
	firstPuzzleImage,
	puzzleHouseImage,
	puzzleDreamImage,
	treesHateYouImage,
];
const gameHrefs = [
	firstPuzzlePagePath,
	puzzleHousePath,
	puzzleDreamPath,
	treesHateYouPath,
];

const languageLinks = buildAlternateLinks(
	{
		en: "/play/puzzle-dream/",
		"zh-cn": "/zh-cn/play/puzzle-dream/",
		fa: "/fa/play/puzzle-dream/",
		fr: "/fr/play/puzzle-dream/",
		id: "/id/play/puzzle-dream/",
		ja: "/ja/play/puzzle-dream/",
		vi: "/vi/play/puzzle-dream/",
	},
	locale,
);

const relatedGames = content.games
	.map((game, index) => ({
		...game,
		image: gameImages[index],
		href: gameHrefs[index],
	}))
	.filter((_, index) => index !== 2);

const pageCopy: Record<
	Locale,
	{
		title: string;
		description: string;
		breadcrumbLabel: string;
		playHeading: string;
		iframeTitle: string;
		playButton: string;
		intro: string;
		overviewHeading: string;
		overviewBody: string;
		tipsHeading: string;
		tips: string[];
	}
> = {
	"zh-cn": {
		title: "HER TREES : PUZZLE DREAM - 免费在线玩 | 40+ 谜题",
		description:
			"免费在线玩 HER TREES : PUZZLE DREAM。系列中最大的作品，包含 40 多个手绘谜题。Steam 和 itch.io Demo 均可体验。95% 好评。",
		breadcrumbLabel: "Puzzle Dream",
		playHeading: "游玩 HER TREES : PUZZLE DREAM",
		iframeTitle: "HER TREES : PUZZLE DREAM 在线试玩",
		playButton: "开始 Puzzle Dream",
		intro:
			"这个页面直接加载 public 目录中的 Puzzle Dream 游戏资源，进入后可以像首页一样点击开始并切换全屏游玩。",
		overviewHeading: "这一页提供什么",
		overviewBody:
			"相较于首页嵌入的 First Puzzle，这里对应的是系列第三作的独立入口，适合想直接体验更完整谜题量和更长流程的玩家。",
		tipsHeading: "游玩提示",
		tips: [
			"首次进入会按需加载 WebGL 资源，开始前可能需要短暂等待。",
			"手机上建议横屏体验；进入全屏时页面会尽量请求横屏锁定。",
			"如果你只是想先快速感受系列风格，仍然可以回首页先玩 First Puzzle。",
		],
	},
	en: {
		title: "HER TREES : PUZZLE DREAM - Play Online Free | 40+ Puzzles",
		description:
			"Play HER TREES : PUZZLE DREAM online for free. The largest entry in the series with 40+ hand-drawn puzzles. Available on Steam and itch.io Demo. 95% positive reviews.",
		breadcrumbLabel: "Puzzle Dream",
		playHeading: "Play HER TREES : PUZZLE DREAM",
		iframeTitle: "HER TREES : PUZZLE DREAM online",
		playButton: "Start Puzzle Dream",
		intro:
			"This page loads the Puzzle Dream build from the public directory and keeps the same click-to-launch and fullscreen flow used on the homepage.",
		overviewHeading: "What this page is for",
		overviewBody:
			"Unlike the homepage embed for First Puzzle, this is a dedicated entry for the third game in the series, intended for players who want the larger dreamlike puzzle set right away.",
		tipsHeading: "Play notes",
		tips: [
			"The first launch may take a moment while the WebGL files load.",
			"Landscape works best on phones; fullscreen will try to lock orientation.",
			"If you want a shorter introduction first, go back to the homepage and start with First Puzzle.",
		],
	},
	fa: {
		title: "HER TREES : PUZZLE DREAM - بازی آنلاین رایگان | بیش از ۴۰ پازل",
		description:
			"HER TREES : PUZZLE DREAM را آنلاین و رایگان بازی کنید. بزرگ‌ترین نسخه مجموعه با بیش از ۴۰ پازل دستی. در Steam و itch.io Demo موجود است.",
		breadcrumbLabel: "Puzzle Dream",
		playHeading: "بازی HER TREES : PUZZLE DREAM",
		iframeTitle: "HER TREES : PUZZLE DREAM آنلاین",
		playButton: "شروع Puzzle Dream",
		intro:
			"این صفحه نسخه Puzzle Dream را از پوشه public بارگذاری می‌کند و همان جریان کلیک‌برای‌شروع و تمام‌صفحه صفحه اصلی را حفظ می‌کند.",
		overviewHeading: "این صفحه برای چیست",
		overviewBody:
			"برخلاف First Puzzle جاسازی‌شده در صفحه اصلی، این ورودی اختصاصی برای بازی سوم مجموعه است، برای بازیکنانی که مجموعه پازل‌های رویایی بزرگ‌تر را فوراً می‌خواهند.",
		tipsHeading: "نکات بازی",
		tips: [
			"اولین راه‌اندازی ممکن است لحظه‌ای طول بکشد تا فایل‌های WebGL بارگذاری شوند.",
			"در گوشی حالت افقی بهتر عمل می‌کند؛ تمام صفحه سعی می‌کند جهت را قفل کند.",
			"اگر ابتدا معرفی کوتاه‌تری می‌خواهید، به صفحه اصلی برگردید و با First Puzzle شروع کنید.",
		],
	},
	fr: {
		title: "HER TREES : PUZZLE DREAM - Jouer en Ligne Gratuit | 40+ Puzzles",
		description:
			"Jouez à HER TREES : PUZZLE DREAM en ligne gratuitement. Le plus grand opus de la série avec plus de 40 puzzles dessinés à la main. Disponible sur Steam et itch.io Demo.",
		breadcrumbLabel: "Puzzle Dream",
		playHeading: "Jouer à HER TREES : PUZZLE DREAM",
		iframeTitle: "HER TREES : PUZZLE DREAM en ligne",
		playButton: "Lancer Puzzle Dream",
		intro:
			"Cette page charge la version Puzzle Dream depuis le dossier public et conserve le même flux de clic-pour-lancer et plein écran que la page d'accueil.",
		overviewHeading: "À quoi sert cette page",
		overviewBody:
			"Contrairement à l'intégration First Puzzle sur la page d'accueil, c'est une entrée dédiée au troisième jeu de la série, destinée aux joueurs qui veulent immédiatement le plus grand ensemble de puzzles oniriques.",
		tipsHeading: "Notes de jeu",
		tips: [
			"Le premier lancement peut prendre un moment pendant le chargement des fichiers WebGL.",
			"Le mode paysage fonctionne mieux sur téléphone ; le plein écran essaiera de verrouiller l'orientation.",
			"Si vous voulez d'abord une introduction plus courte, retournez à la page d'accueil et commencez par First Puzzle.",
		],
	},
	id: {
		title: "HER TREES : PUZZLE DREAM - Main Online Gratis | 40+ Puzzle",
		description:
			"Mainkan HER TREES : PUZZLE DREAM online gratis. Entri terbesar dalam seri dengan 40+ puzzle bergambar tangan. Tersedia di Steam dan itch.io Demo.",
		breadcrumbLabel: "Puzzle Dream",
		playHeading: "Mainkan HER TREES : PUZZLE DREAM",
		iframeTitle: "HER TREES : PUZZLE DREAM online",
		playButton: "Mulai Puzzle Dream",
		intro:
			"Halaman ini memuat build Puzzle Dream dari direktori public dan tetap menggunakan alur klik-untuk-memainkan serta layar penuh yang sama seperti di beranda.",
		overviewHeading: "Fungsi halaman ini",
		overviewBody:
			"Berbeda dari First Puzzle yang tertanam di beranda, ini adalah pintu masuk khusus untuk game ketiga dalam seri, ditujukan bagi pemain yang langsung ingin mencoba kumpulan puzzle bergaya mimpi yang lebih besar.",
		tipsHeading: "Catatan bermain",
		tips: [
			"Peluncuran pertama mungkin perlu beberapa saat saat file WebGL dimuat.",
			"Mode lanskap paling nyaman di ponsel; layar penuh akan mencoba mengunci orientasi.",
			"Jika ingin pengenalan yang lebih singkat dulu, kembali ke beranda dan mainkan First Puzzle.",
		],
	},
	ja: {
		title: "HER TREES : PUZZLE DREAM - 無料オンライン | 40以上の謎",
		description:
			"HER TREES : PUZZLE DREAM を無料でオンラインプレイ。40以上の手描きパズルを含む最大規模の作品。Steam と itch.io Demo で利用可能。",
		breadcrumbLabel: "Puzzle Dream",
		playHeading: "HER TREES : PUZZLE DREAM を遊ぶ",
		iframeTitle: "HER TREES : PUZZLE DREAM ブラウザ版",
		playButton: "Puzzle Dream を始める",
		intro:
			"このページでは public ディレクトリ内の Puzzle Dream ビルドを読み込み、トップページと同じようにクリックして起動し、全画面でも遊べます。",
		overviewHeading: "このページの役割",
		overviewBody:
			"トップページの First Puzzle 埋め込みとは別に、シリーズ第3作へ直接入るための専用ページです。よりボリュームのある夢的な謎解きを遊びたい人向けです。",
		tipsHeading: "プレイのヒント",
		tips: [
			"初回起動では WebGL ファイルの読み込みに少し時間がかかる場合があります。",
			"スマートフォンでは横画面が向いています。全画面時は横向き固定を試みます。",
			"まず短くシリーズの雰囲気を見たい場合は、トップページの First Puzzle から入るのが適しています。",
		],
	},
	vi: {
		title: "HER TREES : PUZZLE DREAM - Chơi Online Miễn Phí | 40+ Câu Đố",
		description:
			"Chơi HER TREES : PUZZLE DREAM online miễn phí. Phần lớn nhất series với hơn 40 câu đố vẽ tay. Có trên Steam và itch.io Demo.",
		breadcrumbLabel: "Puzzle Dream",
		playHeading: "Choi HER TREES : PUZZLE DREAM",
		iframeTitle: "HER TREES : PUZZLE DREAM tren trinh duyet",
		playButton: "Bat dau Puzzle Dream",
		intro:
			"Trang nay tai ban Puzzle Dream nam trong thu muc public, giu cung cach bam de mo game va choi fullscreen giong trang chu.",
		overviewHeading: "Trang nay dung de lam gi",
		overviewBody:
			"Khac voi First Puzzle duoc nhung o trang chu, day la loi vao rieng cho phan thu ba trong series, hop voi nguoi muon choi ngay ban co noi dung dai hon.",
		tipsHeading: "Luu y khi choi",
		tips: [
			"Lan mo dau tien co the can doi trong luc tai tep WebGL.",
			"Dien thoai nen choi ngang man hinh; fullscreen se co gang khoa huong ngang.",
			"Neu ban muon thu nhanh phong cach cua series truoc, hay quay ve trang chu va choi First Puzzle.",
		],
	},
};

const copy = pageCopy[locale];
const guideNoteCopy: Record<
	Locale,
	{
		prefix: string;
		linkLabel: string;
	}
> = {
	"zh-cn": {
		prefix: "如果遇到卡关，",
		linkLabel: "点击此处查看视频攻略",
	},
	en: {
		prefix: "If you get stuck, ",
		linkLabel: "watch the video guide here",
	},
	fa: {
		prefix: "اگر گیر کردید، ",
		linkLabel: "ویدیوی راهنما را اینجا تماشا کنید",
	},
	fr: {
		prefix: "Si vous êtes bloqué, ",
		linkLabel: "regardez la vidéo guide ici",
	},
	id: {
		prefix: "Jika terjebak, ",
		linkLabel: "tonton video panduan di sini",
	},
	ja: {
		prefix: "行き詰まったら、",
		linkLabel: "こちらから攻略動画を確認してください",
	},
	vi: {
		prefix: "Neu bi mac o mot doan, ",
		linkLabel: "bam vao day de xem video huong dan",
	},
};
const downloadCopy: Record<
	Locale,
	{
		label: string;
		note: string;
	}
> = {
	"zh-cn": {
		label: "完整版游戏下载",
		note: "Windows 平台可直接游玩",
	},
	en: {
		label: "Download Full Game",
		note: "Windows version, playable directly after download",
	},
	fa: {
		label: "دانلود نسخه کامل",
		note: "نسخه ویندوز، قابل بازی مستقیم پس از دانلود",
	},
	fr: {
		label: "Télécharger le Jeu Complet",
		note: "Version Windows, jouable directement après téléchargement",
	},
	id: {
		label: "Unduh Game Lengkap",
		note: "Versi Windows, bisa langsung dimainkan setelah diunduh",
	},
	ja: {
		label: "完整版ゲームをダウンロード",
		note: "Windows 版を直接プレイできます",
	},
	vi: {
		label: "Tai ban day du",
		note: "Ban Windows co the choi truc tiep",
	},
};
const canonicalUrl = toAbsoluteUrl(puzzleDreamPath);
const ogLocale = localeToOgLocale(locale);
const ogLocaleAlternates = buildOgLocaleAlternates(locale);
const puzzleDreamSchema = JSON.stringify([
	{
		"@context": "https://schema.org",
		"@type": "VideoGame",
		name: "HER TREES : PUZZLE DREAM",
		url: canonicalUrl,
		description: copy.description,
		image: shareImage,
		gamePlatform: "Web Browser",
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Home",
				item: toAbsoluteUrl(content.path),
			},
			{
				"@type": "ListItem",
				position: 2,
				name: copy.breadcrumbLabel,
				item: canonicalUrl,
			},
		],
	},
]);
---

<html lang={content.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#111111" />
		<meta name="generator" content={Astro.generator} />
		<title>{copy.title}</title>
		<meta name="description" content={copy.description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="index, follow" />
		<meta property="og:title" content={copy.title} />
		<meta property="og:description" content={copy.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={content.siteName} />
		<meta property="og:locale" content={ogLocale} />
		{
			ogLocaleAlternates.map((alternateLocale) => (
				<meta property="og:locale:alternate" content={alternateLocale} />
			))
		}
		<meta property="og:image" content={shareImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={copy.title} />
		<meta name="twitter:description" content={copy.description} />
		<meta name="twitter:image" content={shareImage} />
		<meta name="google-adsense-account" content={adsensePublisherId} />
		{
			languageLinks.map((link) => (
				<link
					rel="alternate"
					hreflang={localeToHreflang(link.locale)}
					href={toAbsoluteUrl(link.href)}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={toAbsoluteUrl("/play/puzzle-dream/")} />
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsensePublisherId}`}
			crossorigin="anonymous"
		></script>
		<script type="application/ld+json" set:html={puzzleDreamSchema}></script>
	</head>
	<body>
		<div class="container-shell">
			<SiteHeader
				locale={locale}
				currentPath={puzzleDreamPath}
				tagline={copy.description}
				languageSwitchLabel={content.languageSwitchLabel}
				languageLinks={languageLinks}
			/>

			<main>
				<nav class="breadcrumb-trail" aria-label="Breadcrumb">
					<a href={content.path}>{content.backHomeLabel}</a>
					<span>/</span>
					<span aria-current="page">{copy.breadcrumbLabel}</span>
				</nav>

				<section class="hero-section">
					<div class="feature-panel">
						<div class="panel-header">
							<h2>{copy.playHeading}</h2>
						</div>
						<div class="feature-box game-embed-shell">
							<button
								type="button"
								class="embed-launch"
								data-game-launch
								data-zoom-surface
								data-embed-src={puzzleDreamEmbedUrl}
								data-target-id="puzzle-dream-game"
								aria-controls="puzzle-dream-game"
								style={`--launch-image: url(${puzzleDreamImage.src})`}
							>
								<span class="embed-launch-image" aria-hidden="true"></span>
								<span class="embed-launch-overlay" aria-hidden="true"></span>
								<span class="embed-launch-content">
									<span class="embed-kicker">HER TREES : Puzzle Dream</span>
									<strong>{copy.playButton}</strong>
								</span>
							</button>
							<iframe
								id="puzzle-dream-game"
								class="game-embed"
								title={copy.iframeTitle}
								loading="lazy"
								allow="fullscreen; autoplay"
								referrerpolicy="strict-origin-when-cross-origin"
							></iframe>
							<div class="rotate-hint" data-rotate-hint aria-live="polite">
								<p>{content.rotateHint}</p>
							</div>
						</div>
						<div class="game-toolbar">
							<div class="game-actions">
								<button
									type="button"
									class="fullscreen-button"
									data-game-fullscreen
									data-target-id="puzzle-dream-game"
									aria-controls="puzzle-dream-game"
								>
									<span class="fullscreen-button-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path
												d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
												fill="none"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path>
										</svg>
									</span>
									<span>{content.fullscreenButton}</span>
								</button>
							</div>
							<p class="game-intro">{copy.overviewBody}</p>
						</div>
						<div class="guide-card">
							<p class="guide-note">
								{guideNoteCopy[locale].prefix}
								<a href={puzzleDreamGuidePath} class="guide-inline-link">
									{guideNoteCopy[locale].linkLabel}
								</a>
							</p>
						</div>
						<div class="download-card">
							<p class="download-note">
								<a
									href={puzzleDreamDownloadUrl}
									class="download-link download-button"
									target="_blank"
									rel="noreferrer"
								>
									<span class="download-button-icons" aria-hidden="true">
										<svg viewBox="0 0 24 24" class="download-icon">
											<path
												d="M3 5.75 11.1 4.6v7.06H3V5.75Zm9.2-1.31L21 3.2v8.46h-8.8V4.44ZM3 12.82h8.1v7.07L3 18.73v-5.91Zm9.2 0H21v8.47l-8.8-1.24v-7.23Z"
												fill="currentColor"
											></path>
										</svg>
										<svg viewBox="0 0 24 24" class="download-icon">
											<path
												d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.29a1 1 0 1 1 1.4 1.41l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.41L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1Z"
												fill="currentColor"
											></path>
										</svg>
									</span>
									<span>{downloadCopy[locale].label}</span>
								</a>
								<span>{downloadCopy[locale].note}</span>
							</p>
						</div>
						<AdUnit />
						</div>
					</section>

				<section class="content-section" id="series">
					<h2>{content.seriesHeading}</h2>
					<div class="games-grid">
						{
							relatedGames.map((game) => (
								<a class="game-card game-card-link" href={game.href}>
									<div class="game-thumbnail">
										<Image
											src={game.image}
											alt={game.alt}
											widths={[480]}
											sizes="(max-width: 760px) 100vw, 280px"
										/>
									</div>
									<p class="game-meta">{game.meta}</p>
									<h3 class="game-title">{game.title}</h3>
									<p class="game-desc">{game.copy}</p>
								</a>
							))
						}
					</div>
				</section>

				<section class="content-section">
					<h2>{copy.overviewHeading}</h2>
					<div class="prose-block">
						<p>{copy.overviewBody}</p>
					</div>
				</section>

				<section class="content-section">
					<h2>{copy.tipsHeading}</h2>
					<div class="bullet-grid">
						{
							copy.tips.map((item) => (
								<article class="bullet-card">
									<p>{item}</p>
								</article>
							))
						}
					</div>
				</section>
			</main>

			<SiteFooter locale={locale} />
		</div>
		<script is:inline>
			const fullscreenTargets = new Set();

			const loadEmbeddedGame = (trigger) => {
				const targetId = trigger.getAttribute("data-target-id");
				const src = trigger.getAttribute("data-embed-src");
				if (!targetId || !src) return null;

				const iframe = document.getElementById(targetId);
				if (!(iframe instanceof HTMLIFrameElement)) return null;

				if (iframe.dataset.loaded !== "true") {
					iframe.src = src;
					iframe.dataset.loaded = "true";
				}

				iframe.classList.add("is-visible");
				trigger.classList.add("is-hidden");
				return iframe;
			};

			const isMobileViewport = () =>
				window.matchMedia("(pointer: coarse)").matches &&
				Math.min(window.innerWidth, window.innerHeight) < 1024;

			const updateRotateHintState = (target, shouldShowHint) => {
				if (!(target instanceof HTMLElement)) return;

				if (shouldShowHint) {
					target.dataset.rotateHintVisible = "true";
					return;
				}

				delete target.dataset.rotateHintVisible;
			};

			const tryLockLandscape = async (target) => {
				if (!(target instanceof HTMLElement)) return false;

				if (!screen.orientation?.lock || !isMobileViewport()) {
					updateRotateHintState(target, false);
					return false;
				}

				try {
					await screen.orientation.lock("landscape");
					updateRotateHintState(target, false);
					return true;
				} catch {
					updateRotateHintState(target, true);
					return false;
				}
			};

			const releaseOrientationLock = () => {
				try {
					screen.orientation?.unlock?.();
				} catch {
					/* no-op */
				}
			};

			document.addEventListener("fullscreenchange", () => {
				fullscreenTargets.forEach((target) => {
					if (!(target instanceof HTMLElement)) return;

					const isActive = document.fullscreenElement === target;
					if (!isActive) {
						updateRotateHintState(target, false);
					}
				});

				if (!document.fullscreenElement) {
					releaseOrientationLock();
				}
			});

			document.querySelectorAll("[data-game-launch]").forEach((button) => {
				button.addEventListener("click", () => {
					loadEmbeddedGame(button);
				});
			});

			document.querySelectorAll("[data-game-fullscreen]").forEach((button) => {
				button.addEventListener("click", async () => {
					const targetId = button.getAttribute("data-target-id");
					if (!targetId) return;

					const iframe = document.getElementById(targetId);
					if (!(iframe instanceof HTMLIFrameElement)) return;

					const launchButton = document.querySelector(
						`[data-game-launch][data-target-id="${targetId}"]`,
					);
					if (launchButton instanceof HTMLButtonElement) {
						loadEmbeddedGame(launchButton);
					}

					const fullscreenTarget = iframe.closest(".game-embed-shell");
					if (!(fullscreenTarget instanceof HTMLElement)) return;
					fullscreenTargets.add(fullscreenTarget);

					if (document.fullscreenElement === fullscreenTarget) {
						await document.exitFullscreen?.();
						return;
					}

					if (fullscreenTarget.requestFullscreen) {
						await fullscreenTarget.requestFullscreen();
						await tryLockLandscape(fullscreenTarget);
					}
				});
			});

			document.querySelectorAll("[data-zoom-surface]").forEach((surface) => {
				if (!(surface instanceof HTMLElement)) return;

				const resetSurface = () => {
					surface.style.setProperty("--pointer-x", "50%");
					surface.style.setProperty("--pointer-y", "50%");
				};

				resetSurface();

				surface.addEventListener("mousemove", (event) => {
					const rect = surface.getBoundingClientRect();
					const x = ((event.clientX - rect.left) / rect.width) * 100;
					const y = ((event.clientY - rect.top) / rect.height) * 100;

					surface.style.setProperty("--pointer-x", `${x}%`);
					surface.style.setProperty("--pointer-y", `${y}%`);
				});

				surface.addEventListener("mouseleave", resetSurface);
			});
		</script>
	</body>
</html>
