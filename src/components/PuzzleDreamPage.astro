const firstPuzzlePagePath =
	locale === "en" ? "/play/first-puzzle/" : `/${locale}/play/first-puzzle/`;
const puzzleHousePath =
	locale === "en" ? "/play/puzzle-house/" : `/${locale}/play/puzzle-house/`;
const treesHateYouPath = "/trees-hate-you/";
const puzzleDreamDownloadUrl =
	"https://game.doritosscript.com/HerTreesPuzzleDream.zip";
const linkifyFaq = (text: string) =>
	text.replace(
		/(\/(?:[a-z]{2,3}(?:-[a-z]+)?\/)?play\/[a-z0-9/-]+\/)/g,
		'<a href="$1">$1</a>',
	);
const shareImage = new URL(puzzleDreamImage.src, siteUrl).toString();
const gameImages = [
	firstPuzzleImage,
	puzzleHouseImage,
	puzzleDreamImage,
	treesHateYouImage,
];
const gameHrefs = [
	firstPuzzlePagePath,
	puzzleHousePath,
	puzzleDreamPath,
	treesHateYouPath,
];

const languageLinks = buildAlternateLinks(
	{
		en: "/play/puzzle-dream/",
		"zh-cn": "/zh-cn/play/puzzle-dream/",
		fa: "/fa/play/puzzle-dream/",
		fr: "/fr/play/puzzle-dream/",
		id: "/id/play/puzzle-dream/",
		ja: "/ja/play/puzzle-dream/",
		vi: "/vi/play/puzzle-dream/",
	},
	locale,
);

const relatedGames = content.games
	.map((game, index) => ({
		...game,
		image: gameImages[index],
		href: gameHrefs[index],
	}))
	.filter((_, index) => index !== 2);

