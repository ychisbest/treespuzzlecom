---
import { siteLinksForLocale } from "../data/site-shell";
import type { Locale } from "../data/home-content";

type Props = {
	locale: Locale;
	currentPath?: string;
};

const { locale, currentPath = "" } = Astro.props;
const links = siteLinksForLocale(locale);

const isPuzzleHouse = currentPath.includes("puzzle-house");
const dreamGuidePath =
	locale === "en" ? "/play/puzzle-dream/guide/" : `/${locale}/play/puzzle-dream/guide/`;
const houseGuidePath =
	locale === "en" ? "/play/puzzle-house/guide/" : `/${locale}/play/puzzle-house/guide/`;

const resolvedLinks = links.map((link) => {
	if (link.label === "Guide" || link.label === "攻略" || link.label === "راهنما" || link.label === "Panduan" || link.label === "Huong dan" || link.label === "ガイド") {
		if (isPuzzleHouse) {
			return { ...link, href: houseGuidePath, openInNewTab: false };
		}
		return { ...link, href: dreamGuidePath, openInNewTab: false };
	}
	return link;
});
---

<nav class="site-nav" aria-label="Primary">
	{
		resolvedLinks.map((link) => (
			<a
				href={link.href}
				target={link.openInNewTab ? "_blank" : undefined}
				rel={link.openInNewTab ? "noopener noreferrer" : undefined}
				class:list={{
					active: currentPath === link.href,
				}}
			>
				{link.label}
			</a>
		))
	}
</nav>
