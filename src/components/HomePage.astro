const support = supportContent[locale];
const downloadCopy: Record<
	Locale,
	{
		label: string;
		note: string;
	}
> = {
	"zh-cn": {
		label: "完整版游戏下载",
		note: "Windows 平台可直接游玩",
	},
	en: {
		label: "Download Full Game",
		note: "Windows version, playable directly after download",
	},
	fa: {
		label: "دانلود نسخه کامل",
		note: "نسخه ویندوز، قابل بازی مستقیم پس از دانلود",
	},
	fr: {
		label: "Télécharger le Jeu Complet",
		note: "Version Windows, jouable directement après téléchargement",
	},
	id: {
		label: "Unduh Game Lengkap",
		note: "Versi Windows, bisa langsung dimainkan setelah diunduh",
	},
	ja: {
		label: "完整版ゲームをダウンロード",
		note: "Windows 版を直接プレイできます",
	},
	vi: {
		label: "Tai ban day du",
		note: "Ban Windows co the choi truc tiep",
	},
};
const homeSchema = JSON.stringify([
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "Her Trees Puzzle Game",
		url: canonicalUrl,
		description: content.pageDescription,
	},
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		name: "treespuzzle.com",
		url: siteUrl,
		email: contactEmail,
		description:
			"Independent editorial website covering the HER TREES puzzle series.",
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: content.faqs.map((faq) => ({
			"@type": "Question",
			name: faq.question,
			acceptedAnswer: {
				"@type": "Answer",
				text: faq.answer,
			},
		})),
	},
]);
---

<html lang={content.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#111111" />
		<meta name="generator" content={Astro.generator} />
		<title>{content.pageTitle}</title>
		<meta name="description" content={content.pageDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="index, follow" />
		<meta property="og:title" content={content.pageTitle} />
		<meta property="og:description" content={content.pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={content.siteName} />
		<meta property="og:locale" content={ogLocale} />
		{
			ogLocaleAlternates.map((alternateLocale) => (
				<meta property="og:locale:alternate" content={alternateLocale} />
			))
		}
		<meta property="og:image" content={shareImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={content.pageTitle} />
		<meta name="twitter:description" content={content.pageDescription} />
		<meta name="twitter:image" content={shareImage} />
		<meta name="google-adsense-account" content={adsensePublisherId} />
		{
			languageLinks.map((link) => (
				<link
					rel="alternate"
					hreflang={localeToHreflang(link.locale)}
					href={toAbsoluteUrl(link.href)}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={toAbsoluteUrl("/")} />
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsensePublisherId}`}
			crossorigin="anonymous"
		></script>
		<script type="text/javascript">
			(function (c, l, a, r, i, t, y) {
				c[a] =
					c[a] ||
					function () {
						(c[a].q = c[a].q || []).push(arguments);
					};
				t = l.createElement(r);
				t.async = 1;
				t.src = "https://www.clarity.ms/tag/" + i;
				y = l.getElementsByTagName(r)[0];
				y.parentNode.insertBefore(t, y);
			})(window, document, "clarity", "script", "vw15uoxtay");
		</script>
		<script type="application/ld+json" set:html={homeSchema}></script>
	</head>
	<body>
		<div class="container-shell">
			<SiteHeader
				locale={locale}
				currentPath={content.path}
				tagline={content.headerIntro}
				languageSwitchLabel={content.languageSwitchLabel}
				languageLinks={languageLinks}
			/>

			<main>
				<section class="hero-section" id="play">
					<div class="feature-panel">
						<div class="panel-header">
							<h2>{content.playHeading}</h2>
							<p class="section-intro">
								{support.updatedLabel}: {lastUpdated}
							</p>
						</div>
						<div class="feature-box game-embed-shell">
							<button
								type="button"
								class="embed-launch"
								data-game-launch
								data-zoom-surface
								data-embed-src={firstPuzzleEmbedUrl}
								data-target-id="her-trees-first-puzzle"
								aria-controls="her-trees-first-puzzle"
								style={`--launch-image: url(${firstPuzzleImage.src})`}
							>
								<span class="embed-launch-image" aria-hidden="true"></span>
								<span class="embed-launch-overlay" aria-hidden="true"></span>
								<span class="embed-launch-content">
									<span class="embed-kicker">HER TREES : First Puzzle</span>
									<strong>{content.playButton}</strong>
								</span>
							</button>
							<iframe
								id="her-trees-first-puzzle"
								class="game-embed"
								title={content.iframeTitle}
								loading="lazy"
								allow="fullscreen; autoplay"
								referrerpolicy="strict-origin-when-cross-origin"
							></iframe>
							<div class="rotate-hint" data-rotate-hint aria-live="polite">
								<p>{content.rotateHint}</p>
							</div>
						</div>
						<div class="game-toolbar">
							<div class="game-actions">
								<button
									type="button"
									class="fullscreen-button"
									data-game-fullscreen
									data-target-id="her-trees-first-puzzle"
									aria-controls="her-trees-first-puzzle"
								>
									<span class="fullscreen-button-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path
												d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
												fill="none"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path>
										</svg>
									</span>
									<span>{content.fullscreenButton}</span>
								</button>
							</div>
							<p class="game-intro">{content.gameIntro}</p>
						</div>
						<div class="guide-card">
							<p class="guide-note">
								{guideNoteCopy[locale].prefix}
								<a href={content.guidePath} class="guide-inline-link">
									{guideNoteCopy[locale].linkLabel}
								</a>
							</p>
						</div>
						<div class="download-card">
							<p class="download-note">
								<a
									href={firstPuzzleDownloadUrl}
									class="download-link download-button"
									target="_blank"
									rel="noreferrer"
								>
									<span class="download-button-icons" aria-hidden="true">
										<svg viewBox="0 0 24 24" class="download-icon">
											<path
												d="M3 5.75 11.1 4.6v7.06H3V5.75Zm9.2-1.31L21 3.2v8.46h-8.8V4.44ZM3 12.82h8.1v7.07L3 18.73v-5.91Zm9.2 0H21v8.47l-8.8-1.24v-7.23Z"
												fill="currentColor"
											></path>
										</svg>
										<svg viewBox="0 0 24 24" class="download-icon">
											<path
												d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.29a1 1 0 1 1 1.4 1.41l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.41L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1Z"
												fill="currentColor"
											></path>
										</svg>
									</span>
									<span>{downloadCopy[locale].label}</span>
								</a>
								<span>{downloadCopy[locale].note}</span>
							</p>
						</div>
						<AdUnit />
						</div>
					</section>

				<section class="content-section" id="series">
					<h2>{content.seriesHeading}</h2>
					<div class="games-grid">
						{
							relatedGames.map((game) =>
								game.href ? (
									<a class="game-card game-card-link" href={game.href}>
										<div class="game-thumbnail">
											<Image
												src={game.image}
												alt={game.alt}
												widths={[480]}
												sizes="(max-width: 760px) 100vw, 280px"
											/>
										</div>
										<p class="game-meta">{game.meta}</p>
										<h3 class="game-title">{game.title}</h3>
										<p class="game-desc">{game.copy}</p>
									</a>
								) : (
									<article class="game-card">
										<div class="game-thumbnail">
											<Image
												src={game.image}
												alt={game.alt}
												widths={[480]}
												sizes="(max-width: 760px) 100vw, 280px"
											/>
										</div>
										<p class="game-meta">{game.meta}</p>
										<h3 class="game-title">{game.title}</h3>
