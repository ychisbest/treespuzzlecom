		aboutBody: "Pelajari siapa yang menjalankan situs, apa yang orisinal di sini, dan bagaimana pembaruan ditangani.",
		contactTitle: "Kontak",
		contactBody: "Gunakan halaman kontak situs untuk koreksi, permintaan hak, atau masalah teknis.",
		updatedLabel: "Terakhir diperbarui",
	},
		ja: {
			editorialHeading: "編集メモ",
			editorialBody:
				"このページは HER TREES シリーズを扱う独立編集サイトのトップページです。概要だけでなく、ポリシー、分析記事、攻略ページも用意し、訪問者と審査側の両方がサイト全体を確認しやすい構成にしています。",
		resourcesHeading: "続けて読む",
		resourcesIntro:
			"トップページ以外にも、攻略、分析記事、サイト紹介、連絡先ページを用意しています。",
		guideTitle: "攻略",
		guideBody: "埋め込み動画で手順を確認したいときに使えるページです。",
		analysisTitle: "分析記事",
		analysisBody: "このシリーズが観察重視で成立している理由を整理しています。",
		aboutTitle: "このサイトについて",
		aboutBody: "独立運営であること、更新方針、修正対応について説明します。",
		contactTitle: "お問い合わせ",
		contactBody: "誤記修正、権利対応、技術的な問題の連絡窓口です。",
		updatedLabel: "最終更新",
	},
		vi: {
			editorialHeading: "Ghi chu bien tap",
			editorialBody:
				"Trang chu nay la mot phan cua website bien tap doc lap gioi thieu dong game HER TREES. Ben canh tong quan va diem choi thu, trang con bo sung bai viet goc, trang huong dan, va cac trang chinh sach de tang do tin cay.",
		resourcesHeading: "Doc tiep",
		resourcesIntro:
			"Neu ban muon xem them noi dung goc, hay mo trang huong dan, bai phan tich, trang gioi thieu, hoac trang lien he.",
		guideTitle: "Huong dan",
		guideBody: "Mo video huong dan nhung san khi ban muon xem loi giai truc tiep.",
		analysisTitle: "Phan tich thiet ke",
		analysisBody: "Giai thich vi sao dong game nay dua vao quan sat hon la nhieu van ban.",
		aboutTitle: "Gioi thieu ve trang",
