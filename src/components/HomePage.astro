---
import { Image } from "astro:assets";
import "../styles/global.css";
import firstPuzzleImage from "../assets/first_puzzle.png";
import puzzleHouseImage from "../assets/puzzle_house.jpg";
import puzzleDreamImage from "../assets/puzzle_dream.png";
import treesHateYouImage from "../assets/trees-hate-you.png";
import animationVideo from "../assets/animation.webm";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import AdUnit from "./AdUnit.astro";
import MockReviewsSection from "./MockReviewsSection.astro";
import {
	homeContent,
	type Locale,
} from "../data/home-content";
import {
	adsensePublisherId,
	contactEmail,
	globalPaths,
	siteUrl,
} from "../data/site-shell";
import {
	buildOgLocaleAlternates,
	homeAlternateLinks,
	localeToHreflang,
	localeToOgLocale,
	toAbsoluteUrl,
} from "../data/seo";

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const content = homeContent[locale];
const firstPuzzleEmbedUrl = "/her-trees-first-puzzle/index.html";
const firstPuzzlePagePath = `${content.path}#play`;
const puzzleHousePagePath =
	locale === "en" ? "/play/puzzle-house/" : `/${locale}/play/puzzle-house/`;
const puzzleDreamPagePath =
	locale === "en" ? "/play/puzzle-dream/" : `/${locale}/play/puzzle-dream/`;
const treesHateYouPagePath = "/trees-hate-you/";
const firstPuzzleDownloadUrl =
	"https://game.doritosscript.com/HerTreesFirstPuzzle.zip";
const shareImage = new URL(firstPuzzleImage.src, siteUrl).toString();
const lastUpdated = "2026-03-18";
const gameImages = [
	firstPuzzleImage,
	puzzleHouseImage,
	puzzleDreamImage,
	treesHateYouImage,
];
const gameHrefs = [
	firstPuzzlePagePath,
	puzzleHousePagePath,
	puzzleDreamPagePath,
	treesHateYouPagePath,
];

const localizedGames = content.games.map((game, index) => ({
	...game,
	image: gameImages[index],
	href: gameHrefs[index],
}));
const relatedGames = localizedGames.filter((_, index) => index !== 0);
const guideNoteCopy: Record<
	Locale,
	{
		prefix: string;
		linkLabel: string;
	}
> = {
	"zh-cn": {
		prefix: "如果遇到卡关，",
		linkLabel: "点击此处查看视频攻略",
	},
	en: {
		prefix: "If you get stuck, ",
		linkLabel: "watch the video guide here",
	},
	fa: {
		prefix: "اگر گیر کردید، ",
		linkLabel: "ویدیوی راهنما را اینجا تماشا کنید",
	},
	fr: {
		prefix: "Si vous êtes bloqué, ",
		linkLabel: "regardez la vidéo guide ici",
	},
	id: {
		prefix: "Jika Anda terjebak, ",
		linkLabel: "tonton video panduan di sini",
	},
	ja: {
		prefix: "行き詰まったら、",
		linkLabel: "こちらから攻略動画を確認してください",
	},
	vi: {
		prefix: "Neu bi mac o mot doan, ",
		linkLabel: "bam vao day de xem video huong dan",
	},
};

const languageLinks = homeAlternateLinks(locale);
const canonicalUrl = toAbsoluteUrl(content.path);
const ogLocale = localeToOgLocale(locale);
const ogLocaleAlternates = buildOgLocaleAlternates(locale);

const supportContent: Record<
	Locale,
	{
		editorialHeading: string;
		editorialBody: string;
		resourcesHeading: string;
		resourcesIntro: string;
		guideTitle: string;
		guideBody: string;
		analysisTitle: string;
		analysisBody: string;
		aboutTitle: string;
		aboutBody: string;
		contactTitle: string;
		contactBody: string;
		updatedLabel: string;
	}
> = {
		"zh-cn": {
			editorialHeading: "站点说明",
			editorialBody:
				"本页是独立整理的 HER TREES 系列信息首页，补充了系列定位、玩法判断、攻略入口、以及站点政策页面，便于审核与访客快速判断内容是否可靠。",
		resourcesHeading: "继续阅读",
		resourcesIntro:
			"如果你想看更多原创内容，可以继续查看攻略、玩法解析、站点介绍和联系方式。",
			guideTitle: "攻略",
			guideBody: "查看嵌入式视频攻略，快速确认关键步骤和解法顺序。",
		analysisTitle: "玩法解析",
		analysisBody: "解释这个系列为什么依赖观察、顺序和图形关系，而不是长篇文字。",
