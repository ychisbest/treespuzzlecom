		var SCRIPT_SRC = "https://bellnewyork.org/21/a8d5a3218c986bebe7c26991d605271c";
		var root =
			document.currentScript &&
			document.currentScript.previousElementSibling;
		if (!root || !root.hasAttribute("data-ad-native")) return;
		if (window.__treesAdNativeMounted || document.getElementById(CONTAINER_ID)) {
			root.hidden = true;
			root.style.display = "none";
			return;
		}
		var slot = root.querySelector(".ad-unit-slot");
		if (!slot) return;
		window.__treesAdNativeMounted = true;
		var box = document.createElement("div");
		box.id = CONTAINER_ID;
		slot.appendChild(box);
		var s = document.createElement("script");
		s.async = true;
		s.setAttribute("data-cfasync", "false");
		s.src = SCRIPT_SRC;
		slot.insertBefore(s, box);
