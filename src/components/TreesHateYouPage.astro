<script is:inline>
    const mobileToggle = document.getElementById("thy-mobile-toggle");
    const mobileMenu = document.getElementById("thy-mobile-menu");
    const gameIframe = document.getElementById("game-iframe");
    const fullscreenButton = document.getElementById("thy-fullscreen-button");

    if (mobileToggle && mobileMenu) {
        const icons = mobileToggle.querySelectorAll("svg");
        const closeMenu = () => {
            mobileMenu.classList.add("hidden");
            mobileToggle.setAttribute("aria-expanded", "false");
            icons[0]?.classList.remove("hidden");
            icons[1]?.classList.add("hidden");
        };

        mobileToggle.addEventListener("click", () => {
            const isHidden = mobileMenu.classList.toggle("hidden");
            mobileToggle.setAttribute("aria-expanded", String(!isHidden));
            icons[0]?.classList.toggle("hidden", !isHidden);
            icons[1]?.classList.toggle("hidden", isHidden);
        });

        mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });
    }

    if (fullscreenButton && gameIframe) {
        fullscreenButton.addEventListener("click", async () => {
            if (document.fullscreenElement) {
                await document.exitFullscreen();
                return;
            }

            if (gameIframe.requestFullscreen) {
                await gameIframe.requestFullscreen();
            }
        });
    }
</script>
