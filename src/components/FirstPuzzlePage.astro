---
import firstPuzzleImage from "../assets/first_puzzle.png";
import "../styles/global.css";
import AdUnit from "./AdUnit.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import SocialBar from "./SocialBar.astro";
import { homeContent, type Locale } from "../data/home-content";
import { adsensePublisherId, siteUrl } from "../data/site-shell";
import {
	buildOgLocaleAlternates,
	firstPuzzleEmbedUrl,
	guideDreamPath,
	guideFirstPath,
	guideHousePath,
	localeToHreflang,
	localeToOgLocale,
	playDreamPath,
	playFirstAlternateLinks,
	playFirstPath,
	playFirstSeo,
	playHousePath,
	toAbsoluteUrl,
} from "../data/seo";

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const content = homeContent[locale];
const seo = playFirstSeo[locale];
const pagePath = playFirstPath(locale);
const guidePath = guideFirstPath(locale);
const dreamPath = playDreamPath(locale);
const dreamGuidePath = guideDreamPath(locale);
const housePath = playHousePath(locale);
const houseGuidePath = guideHousePath(locale);
const embedUrl = firstPuzzleEmbedUrl;
const shareImage = new URL(firstPuzzleImage.src, siteUrl).toString();

const copyByLocale: Record<Locale, { intro: string; play: string }> = {
	en: {
		intro:
			"This is the dedicated play page for Her Trees: First Puzzle — also searched as A Forgotten House. It is the shortest entry in the series: one hand-drawn room where you move and combine objects, then enter letters on the A–I grid. The homepage is only the series hub; use this URL to play. For solutions, open the walkthrough link below. There is no official smartphone app.",
		play: "Start First Puzzle",
	},
	"zh-cn": {
		intro:
			"这是 Her Trees: First Puzzle（也常被搜作 A Forgotten House）的游玩专页，系列最短的一作：在一个手绘房间里移动、组合物件，再在右侧 A–I 键盘输入字母。首页只做系列导航，真正游玩请用本页。需要解法请走下面的攻略。没有官方手机应用。",
		play: "开始 First Puzzle",
	},
	fa: {
		intro:
			"این صفحه اختصاصی بازی Her Trees: First Puzzle است — گاهی با نام A Forgotten House جستجو می‌شود. کوتاه‌ترین اثر مجموعه در یک اتاق دست‌کشیده: اشیاء را جابه‌جا و ترکیب کنید و حروف را در شبکه A–I وارد کنید. صفحه اصلی فقط هاب سری است. برای راه‌حل به راهنما بروید. اپ رسمی موبایل وجود ندارد.",
		play: "شروع First Puzzle",
	},
	fr: {
		intro:
			"Voici la page de jeu dédiée à Her Trees : First Puzzle (aussi cherché comme A Forgotten House). L’entrée la plus courte : une pièce dessinée à la main, où vous déplacez et combinez des objets, puis entrez des lettres sur la grille A–I. La page d’accueil n’est que le hub. Pour les solutions, ouvrez le guide. Pas d’appli mobile officielle.",
		play: "Lancer First Puzzle",
	},
	id: {
		intro:
			"Ini halaman main khusus Her Trees: First Puzzle — juga dicari sebagai A Forgotten House. Entri terpendek: satu ruangan bergambar tangan, geser dan gabungkan objek, lalu masukkan huruf di kisi A–I. Beranda hanya hub seri. Untuk solusi, buka panduan. Tidak ada aplikasi seluler resmi.",
		play: "Mulai First Puzzle",
	},
	ja: {
		intro:
			"ここはハーツリーズ（Her Trees）: First Puzzle（A Forgotten House としても検索される）の専用プレイページです。シリーズ最短の一作で、一室の手描き部屋でオブジェクトを動かして組み合わせ、右の A–I キーパッドに文字を入力します。トップはシリーズ案内だけなので、遊ぶときはこのURLを使ってください。解法は攻略ページへ。公式スマホアプリはありません。",
		play: "First Puzzle を始める",
	},
	vi: {
		intro:
			"Đây là trang chơi riêng của Her Trees: First Puzzle — cũng được tìm với tên A Forgotten House. Phần ngắn nhất: một phòng vẽ tay, bạn di chuyển và kết hợp đồ vật, rồi nhập chữ trên lưới A–I. Trang chủ chỉ là cổng series. Để xem lời giải, mở hướng dẫn. Không có ứng dụng mobile chính thức.",
		play: "Bắt đầu First Puzzle",
	},
};

const copy = copyByLocale[locale];
const languageLinks = playFirstAlternateLinks(locale);
const canonicalUrl = toAbsoluteUrl(pagePath);
const schema = JSON.stringify([
	{
		"@context": "https://schema.org",
		"@type": "VideoGame",
		name: "HER TREES : First Puzzle",
		alternateName: ["Her Trees First Puzzle", "Her Trees A Forgotten House", "A Forgotten House"],
		url: canonicalUrl,
		description: seo.description,
		image: shareImage,
		gamePlatform: "Web Browser",
		playMode: "SinglePlayer",
		genre: ["Puzzle", "Point-and-click"],
	},
]);
---

<html lang={content.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{seo.title}</title>
		<meta name="description" content={seo.description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="index, follow" />
		<meta property="og:title" content={seo.title} />
		<meta property="og:description" content={seo.description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={localeToOgLocale(locale)} />
		{
			buildOgLocaleAlternates(locale).map((item) => (
				<meta property="og:locale:alternate" content={item} />
			))
		}
		{
			languageLinks.map((link) => (
				<link
					rel="alternate"
					hreflang={localeToHreflang(link.locale)}
					href={toAbsoluteUrl(link.href)}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={toAbsoluteUrl("/play/first-puzzle/")} />
		<meta name="google-adsense-account" content={adsensePublisherId} />
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsensePublisherId}`}
			crossorigin="anonymous"
		></script>
		<script type="application/ld+json" set:html={schema}></script>
	</head>
	<body>
		<div class="container-shell">
			<SiteHeader
				locale={locale}
				currentPath={pagePath}
				tagline={seo.description}
				languageSwitchLabel={content.languageSwitchLabel}
				languageLinks={languageLinks}
			/>
			<main>
				<nav class="breadcrumb-trail" aria-label="Breadcrumb">
					<a href={content.path}>{content.backHomeLabel}</a>
					<span>/</span>
					<span aria-current="page">First Puzzle</span>
				</nav>
				<section class="hero-section">
					<div class="feature-panel">
						<div class="panel-header">
							<h1>{seo.h1}</h1>
						</div>
						<AdUnit />
						<div class="feature-box game-embed-shell">
							<button
								type="button"
								class="embed-launch"
								data-game-launch
								data-zoom-surface
								data-embed-src={embedUrl}
								data-target-id="first-puzzle-game"
								aria-controls="first-puzzle-game"
								style={`--launch-image: url(${firstPuzzleImage.src})`}
							>
								<span class="embed-launch-image" aria-hidden="true"></span>
								<span class="embed-launch-overlay" aria-hidden="true"></span>
								<span class="embed-launch-content">
									<span class="embed-kicker">HER TREES : First Puzzle</span>
									<strong>{copy.play}</strong>
								</span>
							</button>
							<iframe
								id="first-puzzle-game"
								class="game-embed"
								title={seo.h1}
								loading="lazy"
								allow="fullscreen; autoplay"
								referrerpolicy="strict-origin-when-cross-origin"
							></iframe>
						</div>
						<p class="game-intro">{copy.intro}</p>
						<p>
							<a href={guidePath}>Her Trees First Puzzle walkthrough</a>
							{" · "}
							<a href={dreamPath}>Her Trees Puzzle Dream</a>
							{" · "}
							<a href={dreamGuidePath}>Her Trees Puzzle Dream walkthrough</a>
							{" · "}
							<a href={housePath}>Her Trees The Puzzle House</a>
							{" · "}
							<a href={houseGuidePath}>The Puzzle House walkthrough</a>
						</p>
						<p>
							<a href={`${guidePath}#forgotten-house`}>A Forgotten House</a>
						</p>
						}
					</div>
				</section>
			</main>
			<SiteFooter locale={locale} />
		</div>
		<script is:inline>
			document.querySelectorAll("[data-game-launch]").forEach((button) => {
				button.addEventListener("click", () => {
					const targetId = button.getAttribute("data-target-id");
					const src = button.getAttribute("data-embed-src");
					const iframe = targetId ? document.getElementById(targetId) : null;
					if (!src || !(iframe instanceof HTMLIFrameElement)) return;
					if (iframe.dataset.loaded !== "true") {
						iframe.src = src;
						iframe.dataset.loaded = "true";
					}
					iframe.classList.add("is-visible");
					button.classList.add("is-hidden");
				});
			});
		</script>
		<SocialBar />
	</body>
</html>
