---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import AdUnit from "../components/AdUnit.astro";
import {
	adsensePublisherId,
	shellContent,
	shareImageUrl,
} from "../data/site-shell";
import type { Locale } from "../data/home-content";
import {
	buildOgLocaleAlternates,
	localeToHreflang,
	localeToOgLocale,
	toAbsoluteUrl,
	type AlternateLink,
} from "../data/seo";

type Props = {
	title: string;
	description: string;
	canonicalPath: string;
	pageHeading: string;
	pageIntro: string;
	locale?: Locale;
	breadcrumbLabel: string;
	schema?: Record<string, unknown> | Array<Record<string, unknown>>;
	languageSwitchLabel?: string;
	languageLinks?: AlternateLink[];
	xDefaultHref?: string;
	robots?: string;
};

const {
	title,
	description,
	canonicalPath,
	pageHeading,
	pageIntro,
	locale = "en",
	breadcrumbLabel,
	schema,
	languageSwitchLabel,
	languageLinks = [],
	xDefaultHref,
	robots = "index, follow",
} = Astro.props;

const shell = shellContent[locale];
const canonicalUrl = toAbsoluteUrl(canonicalPath);
const prefix = locale === "en" ? "" : `/${locale}`;
const relatedPlay = [
	{ href: `${prefix}/play/puzzle-dream/`, label: "Her Trees Puzzle Dream" },
	{ href: `${prefix}/play/puzzle-dream/guide/`, label: "Dream walkthrough" },
	{ href: `${prefix}/play/puzzle-house/`, label: "Puzzle House" },
	{ href: `${prefix}/play/puzzle-house/guide/`, label: "House answers" },
	{ href: `${prefix}/play/first-puzzle/`, label: "First Puzzle" },
];
const serializedSchema = schema
	? JSON.stringify(Array.isArray(schema) ? schema : [schema])
	: "";
const htmlLang = locale === "zh-cn" ? "zh-CN" : locale;
const ogLocale = localeToOgLocale(locale);
const ogLocaleAlternates = buildOgLocaleAlternates(locale);
---

<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#111111" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Her Trees Puzzle Game" />
		<meta property="og:locale" content={ogLocale} />
		{
			ogLocaleAlternates.map((alternateLocale) => (
				<meta property="og:locale:alternate" content={alternateLocale} />
			))
		}
		<meta property="og:image" content={shareImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImageUrl} />
		<meta name="google-adsense-account" content={adsensePublisherId} />
		{
			languageLinks.map((link) => (
				<link
					rel="alternate"
					hreflang={localeToHreflang(link.locale)}
					href={toAbsoluteUrl(link.href)}
				/>
			))
		}
		{
			xDefaultHref && (
				<link rel="alternate" hreflang="x-default" href={toAbsoluteUrl(xDefaultHref)} />
			)
		}
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsensePublisherId}`}
			crossorigin="anonymous"
		></script>
		{serializedSchema && <script type="application/ld+json" set:html={serializedSchema} />}
	</head>
	<body>
		<div class="container-shell static-page-shell">
			<SiteHeader
				locale={locale}
				currentPath={canonicalPath}
				languageSwitchLabel={languageSwitchLabel}
				languageLinks={languageLinks}
			/>

			<main>
				<nav class="breadcrumb-trail" aria-label="Breadcrumb">
					<a href="/">{shell.breadcrumbHome}</a>
					<span>/</span>
					<span aria-current="page">{breadcrumbLabel}</span>
				</nav>

				<article class="static-article">
					<header class="article-header">
						<h1>{pageHeading}</h1>
						<p>{pageIntro}</p>
					</header>
					<AdUnit />
					<div class="article-prose">
						<slot />
					</div>
					<nav class="more-play-grid" aria-label="Play Her Trees">
						{
							relatedPlay.map((item) => (
								<a class="more-play-card" href={item.href}>
									<strong>{item.label}</strong>
									<span>Play or open answers</span>
								</a>
							))
						}
					</nav>
				</article>
			</main>

			<SiteFooter locale={locale} />
		</div>
	</body>
</html>
