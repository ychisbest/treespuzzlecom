# Hashed Astro assets and Unity WebGL files can be cached long-term.
# HTML stays at the Cloudflare Pages default: public, max-age=0, must-revalidate.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/her-trees-first-puzzle/Build/*
  Cache-Control: public, max-age=31536000, immutable

/*.unityweb
  Cache-Control: public, max-age=31536000, immutable
